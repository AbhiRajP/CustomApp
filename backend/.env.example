# Create an app registration that supports organizational (multi-tenant) accounts.
AZURE_CLIENT_ID=your-entra-application-client-id
AZURE_CLIENT_SECRET=your-entra-application-client-secret
AZURE_AUTHORITY=https://login.microsoftonline.com/common
AZURE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AZURE_TOKEN_ENCRYPTION_KEY=

# Must match the browser origin and the redirect URI host used during local development.
DATABASE_URL=sqlite:///./azure_monitor.db
APP_ORIGIN=http://127.0.0.1:3000
APP_COOKIE_SECURE=false

# Optional background refresh cadence in seconds; zero disables scheduled collection.
COST_COLLECTION_INTERVAL_SECONDS=0
